# Copy to a private file on each VPS and fill values before running deploy-mtproto-two-vps.sh.
# Do not commit real secrets, private WireGuard keys, or generated MTProto secrets.

# Shared network plan
WG_INTERFACE=wg-mtproto
WG_SUBNET_CIDR=10.77.0.0/24
WG_VPS1_ADDR=10.77.0.1/24
WG_VPS2_ADDR=10.77.0.2/24
WG_VPS1_IP=10.77.0.1
WG_VPS2_IP=10.77.0.2
WG_PORT=51821

# Public entrypoint visible to Telegram clients
PUBLIC_PORT=443
PUBLIC_HOST=YOUR_VPS1_IP_OR_DOMAIN

# Backend MTProto endpoint, reachable only through WireGuard
MTPROTO_BACKEND_PORT=8443

# WireGuard peer values.
# Generate on each VPS with:
#   sudo ./deploy-mtproto-two-vps.sh prepare
#
# On VPS1 set WG_PEER_PUBLIC_KEY to the public key printed by VPS2.
# On VPS2 set WG_PEER_PUBLIC_KEY to the public key printed by VPS1.
WG_PEER_PUBLIC_KEY=

# VPS1 connects to VPS2 public UDP endpoint.
# Required for install-vps1. Usually the public IP or DNS name of VPS2.
WG_ENDPOINT_HOST=YOUR_VPS2_PUBLIC_IP

# Optional: set explicitly if you want deterministic configs.
# If empty, the script creates and stores a private key under /etc/wireguard.
WG_PRIVATE_KEY=

# Optional MTProto secret.
# If empty on VPS2, the script generates a random 16-byte hex secret.
# For Telegram links the script uses dd-prefixed TLS-style secret.
MTPROTO_SECRET=

# A plausible host for Telegram's TLS-style MTProto secret.
# It is embedded into the generated dd-secret link, not used for TLS termination by this script.
MTPROTO_SECRET_DOMAIN=www.cloudflare.com

# HAProxy relay settings on VPS1
HAPROXY_SERVICE=haproxy

# Docker settings on VPS2
MTPROTO_CONTAINER=mtproto-proxy
MTPROTO_SERVICE=mtproto-proxy
MTPROTO_IMAGE=telegrammessenger/proxy:latest
MTPROTO_DATA_DIR=/var/lib/mtproto-proxy
